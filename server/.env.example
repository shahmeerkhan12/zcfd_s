# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.

PORT=3000

# ── LLM Providers (priority: Groq → Gemini → OpenAI → regex fallback) ────────

# 1. Groq (FREE, no card) — https://console.groq.com -> API Keys -> Create
GROQ_API_KEY=gsk_...

# 2. Gemini 2.0 Flash (FREE, 1500 req/day, no card) — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# 3. OpenAI (backup only, requires credits)
OPENAI_API_KEY=sk-...

# ── Geo Search ────────────────────────────────────────────────────────────────
# Foursquare (free, no card) — https://foursquare.com/developer
# Leave blank → local SQLite with real Kyiv coords (works fine for demo)
FOURSQUARE_API_KEY=fsq3...

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_PATH=./data/food-delivery.sqlite
